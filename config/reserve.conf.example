# claude-reserve configuration.
#
# The live copy lives at ~/.claude/claude-reserve/reserve.conf — edit that one.
# Changes take effect immediately: the hooks re-read this file on every call,
# so you never need to restart a session or reload the watcher.

# ------------------------------------------------------------- main switch --
# false = never block anything. Notifications keep working.
GUARD_ENABLED=true

# --------------------------------------------------------- blocking policy --
# The rule is: block only if you are over the limit AND the window is more than
# GRACE minutes away. The grace window is the point of the whole design — with
# 20 minutes left there is nothing to save, so blocking would be pure friction.

# 5-hour rolling window
SESSION_THRESHOLD=90
SESSION_GRACE_MIN=30

# Weekly window. On smaller plans this is usually the binding limit, so the
# grace window is larger: the last couple of hours are worth spending.
WEEKLY_THRESHOLD=95
WEEKLY_GRACE_MIN=120

# -------------------------------------------------------------- fail-safe ---
# What to do when usage data is missing or stale.
#   open   = let everything through  <- recommended: a broken monitor must not
#            stop you working
#   closed = block anyway
FAIL_MODE=open

# Cache older than this is treated as missing, triggering FAIL_MODE.
STALE_MAX_SEC=900

# ---------------------------------------------------------- notifications ---
# Desktop notification when a turn ends.
NOTIFY_ON_STOP=true
# Skip turns shorter than this, so quick answers stay quiet.
NOTIFY_MIN_TURN_SEC=60
# macOS sound name (Glass, Ping, Pop, Submarine, Hero, Funk...); "" for silent.
NOTIFY_SOUND=Glass
# At most one block notification per this many seconds.
NOTIFY_DEDUPE_SEC=300
# Warn once per window when usage crosses each of these percentages.
ALERT_LEVELS="75 90 95"

# --------------------------------------------------------- phone push (ntfy) -
# Optional. Leave NTFY_TOPIC empty to disable. The topic is a secret address:
# anyone who knows it can read your notifications, so use a long random string.
# Install the ntfy app, subscribe to the same topic, then: claude-reserve ntfy-test
NTFY_TOPIC=""
NTFY_SERVER=https://ntfy.sh
# default | high | urgent   (blocks are always sent as high)
NTFY_PRIORITY=default

# ----------------------------------------------------------------- resume ---
# When claude-reserve blocks a session it remembers the working directory. When
# the window resets it can start that work again.
#
# READ docs/auto-resume.md BEFORE TURNING THIS ON. With AUTO_RESUME=true an
# agent restarts while you are not at the keyboard, spends quota and may edit
# files. That is the point — but it should be a decision, not a surprise.
#
# This file ships with it off, so copying the example by hand is never a
# surprise either. The installer asks and writes your answer here: press Enter
# at the prompt and it becomes true. A non-interactive install (curl | bash)
# has nobody to ask, so it stays false.
AUTO_RESUME=false
RESUME_NOTIFY=true            # notify on reset even when AUTO_RESUME is false
AUTO_RESUME_MAX=3             # never relaunch more than this many at once
AUTO_RESUME_MAX_AGE_H=12      # forget sessions blocked longer ago than this
AUTO_RESUME_PROMPT="Continue where you left off."
# Extra flags for the relaunch. A headless run stalls on permission prompts, so
# if your work needs file edits, set a permission mode here.
AUTO_RESUME_ARGS=""
# `claude-reserve resume --run --terminal` (and the menu bar item) opens a real
# interactive session instead of a headless one. RESUME_TERMINAL_APP is the
# macOS app to open; RESUME_TERMINAL_CMD overrides everything and receives the
# shell command as its last argument — use it for tmux, iTerm, Warp:
#   RESUME_TERMINAL_CMD="tmux new-window"
RESUME_TERMINAL_APP=Terminal
RESUME_TERMINAL_CMD=""
# Absolute path, filled in by the installer. launchd and systemd do not load
# your shell profile, so a bare "claude" often is not found from the watcher.
CLAUDE_BIN=claude

# ----------------------------------------------------------- data sources ---
# Tried in order; the first that answers wins. See docs/data-sources.md.
#
# 1. Claude Code's own status line. It hands our statusline command a JSON blob
#    containing rate_limits after every response — free, authoritative, no
#    request at all. The installer registers it if the slot is free.
USE_STATUSLINE=true
STATUSLINE_MAX_AGE=600       # ignore a capture older than this (seconds)
STATUSLINE_REFRESH_SEC=30    # how often the status line re-parses what it captured
#
# 2. OpenUsage — local HTTP API, instant, no rate limit. Optional.
#    Set to "" to skip it entirely.
OPENUSAGE_BASE=http://127.0.0.1:6736
#
# 3. Anthropic OAuth usage endpoint — authoritative, but undocumented and
#    rate-limited, so it is queried at most once every OAUTH_MIN_INTERVAL
#    seconds. claude-reserve only reads your token, it never rewrites it.
USE_OAUTH_FALLBACK=true
OAUTH_MIN_INTERVAL=300
# Override only if you route through a proxy. This is the one setting that can
# cost you a credential rather than a wrong number, so it is fenced: the token
# is sent over https only, or to 127.0.0.1 for a local proxy. Anything else is
# refused and logged, and `claude-reserve status` says out loud when the
# endpoint is not Anthropic's.
OAUTH_USAGE_URL=https://api.anthropic.com/api/oauth/usage
#
# 4. ccusage — local token estimate from your own logs. Least accurate, since
#    it cannot see usage from other machines.
USE_CCUSAGE=true
CCUSAGE_BIN=ccusage
CCUSAGE_TIMEOUT=8

# ------------------------------------------------------------ performance ---
# How old the cache may get before a hook refreshes it inline. Keep this above
# the watcher interval (90s), otherwise the cache is stale by design and hooks
# pay for a network call on the hot path.
CACHE_TTL=150
# After a failed refresh, don't retry for this long. Without it, a dead source
# would make every single tool call pay the curl timeout.
FAIL_BACKOFF=120
